# Copy to .env (or set these in your MCP client config) — never commit real values.

# Your Testmo instance URL, no trailing slash
TESTMO_INSTANCE=https://your-team.testmo.net

# A Testmo API access key (Testmo → User Profile → API access)
TESTMO_TOKEN=your-testmo-api-key

# Optional: default folder ID for new cases so Testmo doesn't auto-create a
# fresh folder on every create. Leave blank to let Testmo decide.
TESTMO_DEFAULT_FOLDER_ID=
